# ================================================
# NanoClaw 配置文件
# ================================================

# ------------------------------------------------
# 必需：Claude 认证（二选一）
# ------------------------------------------------

# 方式1：Anthropic API Key
# 从 https://console.anthropic.com/ 获取
ANTHROPIC_AUTH_TOKEN=

# Anthropic API 端点（可选，用于第三方代理或自建 API）
# 默认为 https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/

# 模型配置（可选，默认为 claude-sonnet-4）
# 可用模型: claude-opus-4, claude-sonnet-4, claude-haiku-4, kimi-k2.5 等
#CLAUDE_CODE_MODEL=kimi-k2.5

# Anthropic 模型覆盖（用于第三方 API 代理，如 Kimi）
ANTHROPIC_DEFAULT_HAIKU_MODEL=kimi-k2.5
ANTHROPIC_DEFAULT_OPUS_MODEL=kimi-k2.5
ANTHROPIC_DEFAULT_SONNET_MODEL=kimi-k2.5
ANTHROPIC_MODEL=kimi-k2.5

# 方式2：Claude Code OAuth Token（Pro/Max 订阅用户）
# 运行 'claude setup-token' 获取
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# ------------------------------------------------
# 可选：消息频道配置
# 取消注释并填写以启用对应频道
# ------------------------------------------------

# Telegram Bot Token（从 @BotFather 获取）
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Slack App 认证（需要 Bot Token 和 App Token）
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-token

# Discord Bot Token
# DISCORD_BOT_TOKEN=your-discord-bot-token

# ------------------------------------------------
# 可选：高级配置
# ------------------------------------------------

# 助手名称
# ASSISTANT_NAME=Andy

# 日志级别 (trace, debug, info, warn, error, fatal)
# LOG_LEVEL=info

# 容器镜像名称
# CONTAINER_IMAGE=nanoclaw-agent:latest

# 容器超时时间（毫秒）
# CONTAINER_TIMEOUT=1800000

# 容器最大输出大小（字节）
# CONTAINER_MAX_OUTPUT_SIZE=10485760

# 空闲超时时间（毫秒）
# IDLE_TIMEOUT=1800000

# 最大并发容器数
# MAX_CONCURRENT_CONTAINERS=5

# 凭证代理端口
# CREDENTIAL_PROXY_PORT=3001

# 时区
# TZ=Asia/Shanghai

# ------------------------------------------------
# Web Channel 配置（HTTP + SSE API）
# ------------------------------------------------
WEB_API_KEY=nanoclaw_web_secret_2024
WEB_PORT=8080
WEB_HOST=0.0.0.0

# ------------------------------------------------
# Chrome 路径（用于浏览器自动化）
# ------------------------------------------------
# macOS 默认路径
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux 默认路径
# CHROME_PATH=/usr/bin/chromium


# Web Channel Configuration
# Enable HTTP + SSE API for external web applications
# WEB_API_KEY=your_shared_secret_key_here
# WEB_PORT=8080
# WEB_HOST=0.0.0.0

# Shared directories for file uploads/outputs (must be shared with web application)
# SHARED_UPLOADS_DIR=/shared/uploads
# SHARED_OUTPUTS_DIR=/shared/outputs

# Assistant Configuration
# ASSISTANT_NAME=Andy
# ASSISTANT_HAS_OWN_NUMBER=false

# Container Configuration
# CONTAINER_IMAGE=nanoclaw-agent:latest
# CONTAINER_TIMEOUT=1800000
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5

# Anthropic API Configuration (loaded by credential proxy)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
